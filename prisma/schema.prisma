generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model account_identities {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  account_id       String    @db.Uuid
  provider         String
  provider_subject String
  email            String?
  email_normalized String?
  email_verified   Boolean   @default(false)
  created_at       DateTime  @default(now()) @db.Timestamptz(6)
  last_used_at     DateTime? @db.Timestamptz(6)
  accounts         accounts  @relation(fields: [account_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([provider, provider_subject])
}

model account_permission_overrides {
  id                     String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  account_id             String      @db.Uuid
  permission_id          String      @db.Uuid
  effect                 String
  reason                 String?
  assigned_by_account_id String?     @db.Uuid
  created_at             DateTime    @default(now()) @db.Timestamptz(6)
  updated_at             DateTime    @default(now()) @db.Timestamptz(6)
  accounts               accounts    @relation(fields: [account_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  permissions            permissions @relation(fields: [permission_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([account_id, permission_id])
}

model account_roles {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  account_id             String    @db.Uuid
  role_id                String    @db.Uuid
  assigned_by_account_id String?   @db.Uuid
  created_at             DateTime  @default(now()) @db.Timestamptz(6)
  expires_at             DateTime? @db.Timestamptz(6)
  accounts               accounts  @relation(fields: [account_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  roles                  roles     @relation(fields: [role_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([account_id, role_id])
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model accounts {
  id                           String                         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actor_type                   String                         @default("customer")
  status                       String                         @default("active")
  display_name                 String?
  primary_email                String?
  created_at                   DateTime                       @default(now()) @db.Timestamptz(6)
  updated_at                   DateTime                       @default(now()) @db.Timestamptz(6)
  last_login_at                DateTime?                      @db.Timestamptz(6)
  account_identities           account_identities[]
  account_permission_overrides account_permission_overrides[]
  account_roles                account_roles[]
  sessions                     sessions[]
  account_mfa                  account_mfa?
  recovery_codes               recovery_codes[]
}

model account_mfa {
  account_id                  String    @id @db.Uuid
  pending_secret_encrypted    String?
  secret_encrypted            String?
  enabled                     Boolean   @default(false)
  last_totp_step              BigInt?
  confirmed_at                DateTime? @db.Timestamptz(6)
  recovery_codes_generated_at DateTime? @db.Timestamptz(6)
  created_at                  DateTime  @default(now()) @db.Timestamptz(6)
  updated_at                  DateTime  @default(now()) @db.Timestamptz(6)
  accounts                    accounts  @relation(fields: [account_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model mfa_policy {
  id                    Int       @id @default(1)
  mode                  String    @default("optional")
  required_roles        String[]  @default([])
  step_up_ttl_sec       Int       @default(300)
  updated_by_account_id String?   @db.Uuid
  created_at            DateTime  @default(now()) @db.Timestamptz(6)
  updated_at            DateTime  @default(now()) @db.Timestamptz(6)
}

model recovery_codes {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  account_id String    @db.Uuid
  code_hash  String
  used_at    DateTime? @db.Timestamptz(6)
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  accounts   accounts  @relation(fields: [account_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([account_id, used_at])
}

model analytics_events {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  event_ref          String?  @unique(map: "analytics_event_ref_uq")
  event_type         String
  order_id           String?  @db.Uuid
  payment_attempt_id String?  @db.Uuid
  support_case_id    String?  @db.Uuid
  work_order_id      String?  @db.Uuid
  publication_id     String?  @db.Uuid
  collection_id      String?  @db.Uuid
  drop_id            String?  @db.Uuid
  item_type          String?
  garment_type       String?
  garment_model      String?
  color              String?
  size               String?
  grammage_g         Int?
  fit                String?
  shipping_method    String?
  shipping_provider  String?
  status             String?
  state_code         String?
  quantity           Int?
  amount_mxn         Int?
  occurred_at        DateTime @default(now()) @db.Timestamptz(6)
  payload            Json?
  created_at         DateTime @default(now()) @db.Timestamptz(6)
}

model assets {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  object_key          String   @unique
  file_name           String?
  content_type        String
  visibility          String   @default("private")
  category            String?
  size_bytes          BigInt   @default(0)
  etag                String?
  upload_status       String   @default("ready")
  declared_size_bytes BigInt?
  upload_expires_at   DateTime? @db.Timestamptz(6)
  upload_started_at   DateTime? @db.Timestamptz(6)
  uploaded_at         DateTime? @db.Timestamptz(6)
  created_at          DateTime @default(now()) @db.Timestamptz(6)
  updated_at          DateTime @default(now()) @db.Timestamptz(6)

  @@index([upload_status, upload_expires_at, updated_at], map: "assets_upload_cleanup_idx")
}

model audit_log {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  account_id    String?  @db.Uuid
  actor_type    String
  action        String
  resource_type String
  resource_id   String?
  reason        String?
  payload       Json?
  ip            String?
  user_agent    String?
  created_at    DateTime @default(now()) @db.Timestamptz(6)

  @@index([created_at(sort: Desc)], map: "audit_log_created_idx")
}

model auth_events {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  event_type       String
  account_id       String?  @db.Uuid
  session_id       String?  @db.Uuid
  email_normalized String?
  ip               String?
  user_agent       String?
  meta             Json?
  created_at       DateTime @default(now()) @db.Timestamptz(6)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model cart_items {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cart_id           String   @db.Uuid
  item_type         String
  publication_id    String?  @db.Uuid
  publication_slug  String?
  design_variant_id String?  @db.Uuid
  garment_type      String
  garment_model     String   @default("")
  color             String
  size              String
  grammage_g        Int
  fit               String   @default("")
  quantity          Int
  unit_price_mxn    Int
  custom_front      Json?
  custom_back       Json?
  custom_note       String?
  improve_quality   Boolean  @default(false)
  drop_id           String?  @db.Uuid
  drop_total_limit  Int?
  meta              Json?
  created_at        DateTime @default(now()) @db.Timestamptz(6)
  updated_at        DateTime @default(now()) @db.Timestamptz(6)
  carts             carts    @relation(fields: [cart_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model carts {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  status            String              @default("active")
  guest_session_id  String?
  account_id        String?             @db.Uuid
  cart_access_token_hash String?
  created_at        DateTime            @default(now()) @db.Timestamptz(6)
  updated_at        DateTime            @default(now()) @db.Timestamptz(6)
  cart_items        cart_items[]
  checkout_sessions checkout_sessions[]
}

model checkout_sessions {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cart_id            String    @db.Uuid
  status             String    @default("pending")
  email              String
  phone              String
  address            Json
  shipping_method    String
  shipping_quote_id  String?
  shipping_provider  String?
  shipping_service   String?
  shipping_cost_mxn  Int       @default(0)
  shipping_quotes    Json?
  subtotal_mxn       Int
  total_mxn          Int
  currency           String    @default("MXN")
  paid_at            DateTime? @db.Timestamptz(6)
  payment_attempt_id String?   @db.Uuid
  order_id           String?   @db.Uuid
  created_at         DateTime  @default(now()) @db.Timestamptz(6)
  updated_at         DateTime  @default(now()) @db.Timestamptz(6)
  carts              carts     @relation(fields: [cart_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model collection_set_items {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  collection_id    String           @db.Uuid
  publication_id   String           @db.Uuid
  position_index   Int              @default(0)
  collections_sets collections_sets @relation(fields: [collection_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  publications     publications     @relation(fields: [publication_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([collection_id, publication_id])
}

model collections_sets {
  id                   String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug                 String                 @unique
  title                String
  description          String?
  visibility           String                 @default("public")
  cover_asset_id       String?                @db.Uuid
  informative_image_id String?                @db.Uuid
  created_at           DateTime               @default(now()) @db.Timestamptz(6)
  updated_at           DateTime               @default(now()) @db.Timestamptz(6)
  collection_set_items collection_set_items[]
}

model customizer_pricing_configs {
  id                        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  base_price_mxn            Int
  per_image_price_mxn       Int
  included_images           Int      @default(0)
  max_images                Int      @default(10)
  quality_upgrade_price_mxn Int      @default(0)
  is_active                 Boolean  @default(true)
  created_at                DateTime @default(now()) @db.Timestamptz(6)
  updated_at                DateTime @default(now()) @db.Timestamptz(6)
}

model design_variants {
  id                      String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  design_id               String                @db.Uuid
  code                    String
  label                   String
  dtf_asset_id            String                @db.Uuid
  public_preview_asset_id String?               @db.Uuid
  front_design_url        String?
  back_design_url         String?
  is_active               Boolean               @default(true)
  sort_rank               Int                   @default(0)
  created_at              DateTime              @default(now()) @db.Timestamptz(6)
  updated_at              DateTime              @default(now()) @db.Timestamptz(6)
  designs                 designs               @relation(fields: [design_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  publication_mockups     publication_mockups[]

  @@unique([design_id, code])
}

model designs {
  id                       String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                     String
  has_variants             Boolean           @default(false)
  default_front_design_url String?
  default_back_design_url  String?
  created_at               DateTime          @default(now()) @db.Timestamptz(6)
  updated_at               DateTime          @default(now()) @db.Timestamptz(6)
  design_variants          design_variants[]
  publications             publications[]
}

model drop_counters {
  drop_id     String   @id @db.Uuid
  last_number Int      @default(0)
  updated_at  DateTime @default(now()) @db.Timestamptz(6)
}

model drop_items {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  drop_id        String       @db.Uuid
  publication_id String       @db.Uuid
  position_index Int          @default(0)
  drops          drops        @relation(fields: [drop_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  publications   publications @relation(fields: [publication_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([drop_id, publication_id])
}

model drops {
  id                   String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug                 String       @unique
  title                String
  description          String?
  status               String       @default("preview")
  starts_at            DateTime?    @db.Timestamptz(6)
  ends_at              DateTime?    @db.Timestamptz(6)
  capacity_total       Int?
  visibility           String       @default("public")
  cover_asset_id       String?      @db.Uuid
  informative_image_id String?      @db.Uuid
  created_at           DateTime     @default(now()) @db.Timestamptz(6)
  updated_at           DateTime     @default(now()) @db.Timestamptz(6)
  drop_items           drop_items[]
}

model informative_images {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  scope_type String
  scope_id   String?  @db.Uuid
  asset_id   String   @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz(6)
}

model inventory_items {
  id                  String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  garment_type        String
  garment_model       String                @default("")
  color               String
  size                String
  grammage_g          Int
  fit                 String                @default("")
  quantity            Int                   @default(0)
  supplier_cost_mxn   Decimal               @default(0) @db.Decimal(12, 2)
  created_at          DateTime              @default(now()) @db.Timestamptz(6)
  updated_at          DateTime              @default(now()) @db.Timestamptz(6)
  inventory_movements inventory_movements[]
  stock_entries       stock_entries[]

  @@unique([garment_type, garment_model, color, size, grammage_g, fit])
}

model inventory_movements {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  inventory_item_id String          @db.Uuid
  movement_type     String
  quantity          Int
  reason            String?
  actor             String?
  source_ref        String?
  created_at        DateTime        @default(now()) @db.Timestamptz(6)
  inventory_items   inventory_items @relation(fields: [inventory_item_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([inventory_item_id, created_at(sort: Desc)], map: "inventory_movements_item_idx")
}

model local_address_changes {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  shipment_id String?  @db.Uuid
  order_id    String   @db.Uuid
  old_address Json
  new_address Json
  reason      String?
  changed_by  String?
  created_at  DateTime @default(now()) @db.Timestamptz(6)
}

model local_delivery_evidences {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  shipment_id String    @db.Uuid
  photo_url   String?
  notes       String?
  created_by  String?
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  shipments   shipments @relation(fields: [shipment_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model login_challenges {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  method           String
  email            String
  email_normalized String
  code_hash        String
  expires_at       DateTime  @db.Timestamptz(6)
  consumed_at      DateTime? @db.Timestamptz(6)
  attempts         Int       @default(0)
  max_attempts     Int       @default(5)
  send_count       Int       @default(1)
  last_sent_at     DateTime? @db.Timestamptz(6)
  ip               String?
  user_agent       String?
  created_at       DateTime  @default(now()) @db.Timestamptz(6)

  @@index([email_normalized, created_at(sort: Desc)], map: "login_challenges_email_idx")
}

model migration_runs {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  migration_key String    @unique
  status        String
  details       Json?
  started_at    DateTime  @default(now()) @db.Timestamptz(6)
  completed_at  DateTime? @db.Timestamptz(6)
}

model notification_deliveries {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  template_key        String
  channel             String
  recipient           String
  payload             Json
  status              String
  attempts            Int       @default(0)
  last_error          String?
  provider_message_id String?
  next_retry_at       DateTime? @db.Timestamptz(6)
  delivered_at        DateTime? @db.Timestamptz(6)
  created_at          DateTime  @default(now()) @db.Timestamptz(6)
  updated_at          DateTime  @default(now()) @db.Timestamptz(6)
}

model order_items {
  id                String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_id          String       @db.Uuid
  cart_item_id      String       @db.Uuid
  item_type         String
  publication_id    String?      @db.Uuid
  publication_slug  String?
  design_variant_id String?      @db.Uuid
  garment_type      String
  garment_model     String
  color             String
  size              String
  grammage_g        Int
  fit               String
  quantity          Int
  unit_price_mxn    Int
  drop_id           String?      @db.Uuid
  drop_total_limit  Int?
  snapshot          Json
  created_at        DateTime     @default(now()) @db.Timestamptz(6)
  orders            orders       @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  work_orders       work_orders?
}

model order_state_history {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_id        String   @db.Uuid
  previous_status String?
  new_status      String
  source          String
  reason          String?
  changed_by      String?
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  orders          orders   @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model orders {
  id                  String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  checkout_session_id String                @unique @db.Uuid
  payment_attempt_id  String                @db.Uuid
  payment_reference   String
  customer_access_token_hash String?
  customer_email      String
  customer_phone      String
  shipping_method     String
  shipping_cost_mxn   Int
  subtotal_mxn        Int
  total_mxn           Int
  currency            String                @default("MXN")
  address             Json
  status              String                @default("paid")
  tracking_number     String?
  tracking_carrier    String?
  tracking_url        String?
  shipping_label_url  String?
  drop_id             String?               @db.Uuid
  drop_number         Int?
  drop_total_limit    Int?
  created_at          DateTime              @default(now()) @db.Timestamptz(6)
  updated_at          DateTime              @default(now()) @db.Timestamptz(6)
  order_items         order_items[]
  order_state_history order_state_history[]
  work_orders         work_orders[]
}

model payment_attempts {
  id                         String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  checkout_session_id        String                 @db.Uuid
  status                     String
  amount_mxn                 Int
  currency                   String                 @default("MXN")
  provider                   String
  provider_payment_intent_id String?
  provider_charge_id         String?
  client_secret              String?
  failure_reason             String?
  metadata                   Json?
  created_at                 DateTime               @default(now()) @db.Timestamptz(6)
  updated_at                 DateTime               @default(now()) @db.Timestamptz(6)
  payment_transactions       payment_transactions[]
}

model webhook_events {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider        String
  event_id        String
  event_id_source String
  event_type      String
  payload         Json
  payload_sha256  String
  status          String    @default("processing")
  attempts        Int       @default(1)
  last_error      String?
  received_at     DateTime  @default(now()) @db.Timestamptz(6)
  processed_at    DateTime? @db.Timestamptz(6)
  updated_at      DateTime  @default(now()) @db.Timestamptz(6)

  @@unique([provider, event_id])
  @@index([status, updated_at])
}

model payment_transactions {
  id                  String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  payment_attempt_id  String           @db.Uuid
  checkout_session_id String           @db.Uuid
  status              String
  amount_mxn          Int
  currency            String           @default("MXN")
  provider            String
  provider_charge_id  String?
  refunded_amount_mxn Int              @default(0)
  created_at          DateTime         @default(now()) @db.Timestamptz(6)
  updated_at          DateTime         @default(now()) @db.Timestamptz(6)
  payment_attempts    payment_attempts @relation(fields: [payment_attempt_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  refunds             refunds[]
}

model permissions {
  id                           String                         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  screen                       String
  action                       String
  description                  String?
  created_at                   DateTime                       @default(now()) @db.Timestamptz(6)
  updated_at                   DateTime                       @default(now()) @db.Timestamptz(6)
  account_permission_overrides account_permission_overrides[]
  role_permissions             role_permissions[]

  @@unique([screen, action])
}

model publication_mockups {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  publication_id  String           @db.Uuid
  variant_id      String?          @db.Uuid
  garment_color   String?
  mockup_asset_id String           @db.Uuid
  view_side       String           @default("front")
  mockup_url      String?
  created_at      DateTime         @default(now()) @db.Timestamptz(6)
  publications    publications     @relation(fields: [publication_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  design_variants design_variants? @relation(fields: [variant_id], references: [id], onUpdate: NoAction)
}

model publications {
  id                     String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug                   String                 @unique
  title                  String
  description            String?
  garment_type           String
  garment_model          String?
  design_id              String                 @db.Uuid
  category               String
  visibility             String                 @default("public")
  is_active              Boolean                @default(true)
  is_seasonal            Boolean                @default(false)
  sort_rank              Int                    @default(0)
  price_mxn              Int
  cover_asset_id         String?                @db.Uuid
  preview_front_asset_id String?                @db.Uuid
  preview_back_asset_id  String?                @db.Uuid
  informative_image_id   String?                @db.Uuid
  viewer_asset_id        String?                @db.Uuid
  front_print_x_pct      Float                  @default(34)
  front_print_y_pct      Float                  @default(25)
  front_print_w_pct      Float                  @default(32)
  front_print_h_pct      Float                  @default(34)
  back_print_x_pct       Float                  @default(32)
  back_print_y_pct       Float                  @default(23)
  back_print_w_pct       Float                  @default(36)
  back_print_h_pct       Float                  @default(36)
  created_at             DateTime               @default(now()) @db.Timestamptz(6)
  updated_at             DateTime               @default(now()) @db.Timestamptz(6)
  collection_set_items   collection_set_items[]
