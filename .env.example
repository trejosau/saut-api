NODE_ENV=development
HOST=0.0.0.0
PORT=8080

# These host ports match the root Compose defaults. Keep credentials in sync with .env.
DATABASE_URL=postgres://saut:CHANGE_ME_POSTGRES_PASSWORD@localhost:15432/saut
POSTGRES_ADMIN_URL=postgres://saut:CHANGE_ME_POSTGRES_PASSWORD@localhost:15432/postgres
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@localhost:16379/0

CORS_ALLOWED_ORIGINS=http://localhost:4200

# Development auth/session secrets; replace for any shared environment.
AUTH_CODE_SECRET=CHANGE_ME_AUTH_CODE_SECRET
AUTH_TOKEN_SECRET=CHANGE_ME_AUTH_TOKEN_SECRET
AUTH_INTERNAL_API_KEY=CHANGE_ME_AUTH_INTERNAL_API_KEY
AUTH_SESSION_TTL_SEC=2592000
AUTH_ACCESS_TTL_SEC=900
AUTH_DEV_RETURN_CODE=true
AUTH_AUTO_CREATE=true
AUTH_ADMIN_EMAILS=albertosaut@gmail.com
AUTH_MAGIC_LINK_BASE_URL=http://localhost:4200/auth/verify
AUTH_GOOGLE_REDIRECT_URI=http://localhost:8080/api/auth/google/callback
AUTH_GOOGLE_FRONTEND_BASE_URL=http://localhost:4200

# MinIO/S3
S3_ENDPOINT=http://localhost:19000
S3_PUBLIC_ENDPOINT=http://localhost:8080
S3_REGION=us-east-1
S3_BUCKET=saut-assets
S3_ACCESS_KEY=saut_minio
S3_SECRET_KEY=CHANGE_ME_MINIO_ROOT_PASSWORD
ASSETS_SIGNING_SECRET=CHANGE_ME_ASSETS_SIGNING_SECRET
ASSETS_INTERNAL_API_KEY=CHANGE_ME_ASSETS_INTERNAL_API_KEY

# External providers stay mocked for the MVP.
STRIPE_MODE=mock
STRIPE_SECRET_KEY=sk_test_mock
STRIPE_WEBHOOK_SECRET=whsec_mock
STRIPE_WEBHOOK_TOLERANCE_SEC=300
SKYDROPX_MODE=mock
SKYDROPX_WEBHOOK_AUTH_HEADER=authorization
NOTIFICATION_DEV_MODE=true

MIGRATION_IMPORT_LEGACY_DATABASES=false
MIGRATION_DROP_LEGACY_DATABASES=false
