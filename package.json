{
  "name": "saut-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run prisma:deploy && npm run bootstrap && tsx watch src/index.ts",
    "start": "node dist/src/index.js",
    "build": "npm run prisma:generate && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src tests --max-warnings=0",
    "test": "vitest run",
    "e2e": "node tests/e2e-stack.mjs",
    "bootstrap": "tsx src/bootstrap.ts",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:generate": "prisma generate",
    "prisma:status": "prisma migrate status",
    "prisma:validate": "prisma validate",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.850.0",
    "@fastify/cors": "^11.0.1",
    "@fastify/websocket": "^11.2.0",
    "@nestjs/common": "^11.1.27",
    "@nestjs/core": "^11.1.27",
    "@nestjs/platform-fastify": "^11.1.27",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "fastify": "5.8.5",
    "ioredis": "^5.6.1",
    "jose": "^6.0.11",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "stripe": "^18.3.0",
    "ws": "^8.18.3",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@eslint/js": "^9.29.0",
    "@types/node": "^24.0.3",
    "@types/pg": "^8.15.4",
    "@types/ws": "^8.18.1",
    "eslint": "^9.29.0",
    "prisma": "^7.8.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.34.1",
    "vitest": "^3.2.4"
  }
}
